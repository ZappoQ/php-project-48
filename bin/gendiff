#!/usr/bin/env php
<?php

ini_set('error_reporting', E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED);

require_once __DIR__ . '/../vendor/autoload.php';

require_once __DIR__ . '/../src/Parsing.php';
require_once __DIR__ . '/../src/Builder.php';
require_once __DIR__ . '/../src/Formatters.php';
require_once __DIR__ . '/../src/Differ.php';

$usage = <<<'USAGE'
Generate diff

Usage:
  gendiff (-h|--help)
  gendiff (-v|--version)
  gendiff [--format <fmt>] <firstFile> <secondFile>

Options:
  -h --help                     Show this screen
  -v --version                  Show version
  --format <fmt>                Report format [default: stylish]

USAGE;

try {
    $args = Docopt::handle($usage, ['version' => '1.0.0']);

    if (!$args['--help'] && !$args['--version']) {
        $firstFile = $args['<firstFile>'];
        $secondFile = $args['<secondFile>'];
        $format = $args['--format'] ?? 'stylish';

        $data1 = \ZappoQ\parseFile($firstFile);
        $data2 = \ZappoQ\parseFile($secondFile);

        echo \ZappoQ\genDiff($data1, $data2, $format);
    }
} catch (Exception $e) {
    echo $e->getMessage() . PHP_EOL;
    exit(1);
}
