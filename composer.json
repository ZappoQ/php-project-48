{
    "name": "hexlet/code",
    "description": "Вычислитель отличий между файлами",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "docopt/docopt": "^1.0",
        "symfony/yaml": "^5.4|^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "files": [
            "src/Differ/Parsing.php",
            "src/Differ/Builder.php",
            "src/Differ/Formatters/Stylish.php",
            "src/Differ/Formatters/Plain.php",
            "src/Differ/Formatters/Json.php",
            "src/Differ/Formatters.php",
            "src/Differ/Differ.php"
        ],
        "psr-4": {
            "Differ\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Differ\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 src tests",
        "fix": "phpcbf --standard=PSR12 src tests"
    },
    "bin": [
        "bin/gendiff"
    ]
}
